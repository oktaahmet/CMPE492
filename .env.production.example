X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=replace-with-cdp-api-key-id
CDP_PRIVATE_KEY=replace-with-cdp-ed25519-private-key

X402_PAYER_PRIVATE_KEY=replace-with-funded-wallet-private-key
X402_NETWORK=eip155:84532
X402_ASSET_ADDRESS=0x036cbd53842c5426634e7929541ec2318f3dcf7e
X402_TOKEN_NAME=USDC
X402_TOKEN_VERSION=2
X402_AMOUNT_DECIMALS=6

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=x402_scheduler_db
POSTGRES_SSLMODE=disable

MAX_RESULT_PAYLOAD_BYTES=10485760

WORKER_JWT_SECRET=replace-with-long-random-secret
WORKER_JWT_TTL_SECONDS=43200
WORKER_AUTH_CHALLENGE_TTL_SECONDS=300
WORKER_AUTH_DISABLED=0

PAYMENTS_PROCESS_INTERVAL_SECONDS=5

ADMIN_API_TOKEN=replace-with-long-random-admin-token

# Public HTTPS entrypoint. For a VPS without a custom domain, use:
# PUBLIC_HOST=<your-vps-ip>.sslip.io
PUBLIC_HOST=replace-with-your-vps-ip.sslip.io
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443

VITE_WORKER_BUSY_LOOP_DELAY_MS=0
VITE_WORKER_IDLE_DELAY_INITIAL_MS=250
VITE_WORKER_IDLE_DELAY_MAX_MS=5000
VITE_WORKER_IDLE_DELAY_MULTIPLIER=2
