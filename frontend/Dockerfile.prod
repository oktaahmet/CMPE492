FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_WORKER_BUSY_LOOP_DELAY_MS=0
ARG VITE_WORKER_IDLE_DELAY_INITIAL_MS=250
ARG VITE_WORKER_IDLE_DELAY_MAX_MS=5000
ARG VITE_WORKER_IDLE_DELAY_MULTIPLIER=2
ENV VITE_WORKER_BUSY_LOOP_DELAY_MS=$VITE_WORKER_BUSY_LOOP_DELAY_MS
ENV VITE_WORKER_IDLE_DELAY_INITIAL_MS=$VITE_WORKER_IDLE_DELAY_INITIAL_MS
ENV VITE_WORKER_IDLE_DELAY_MAX_MS=$VITE_WORKER_IDLE_DELAY_MAX_MS
ENV VITE_WORKER_IDLE_DELAY_MULTIPLIER=$VITE_WORKER_IDLE_DELAY_MULTIPLIER

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
