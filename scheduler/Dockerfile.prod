FROM golang:1.25-bookworm AS build

WORKDIR /src

COPY app/go.mod app/go.sum ./
RUN go mod download

COPY app/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/x402-scheduler ./cmd

FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates emscripten g++ wget \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/x402-scheduler /usr/local/bin/x402-scheduler
COPY app/docs ./docs
COPY app/static ./static
COPY app/workflows ./workflows

EXPOSE 8080

CMD ["x402-scheduler"]
