{
  "id": "wf-two-stage-research-driven-queue-011",
  "nodes": [
    {
      "id": "fetch-queueing-metadata",
      "wasm_url": "/example-11/fetch_queueing_metadata.wasm?v=1",
      "execution_target": "browser_worker",
      "args": [
        {
          "timeout_ms": 3000,
          "url": "https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&titles=Queueing_theory&prop=extracts&exintro=1&explaintext=1"
        }
      ],
      "replication_factor": 2,
      "acceptance_policy": "consensus",
      "traits": ["network", "deterministic"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.04"
    },
    {
      "id": "derive-baseline-config",
      "depends_on": ["fetch-queueing-metadata"],
      "wasm_url": "/example-11/derive_baseline_config.wasm?v=1",
      "execution_target": "server",
      "args": [
        {
          "customer_floor": 420,
          "customer_span": 220,
          "interarrival_floor_ms": 92,
          "service_floor_ms": 68,
          "stress_floor_pct": 130
        }
      ],
      "replication_factor": 1,
      "traits": ["config", "bridge"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.00"
    },
    {
      "id": "run-baseline-simulations",
      "depends_on": ["derive-baseline-config"],
      "wasm_url": "/example-11/simulate_adaptive_queue.wasm?v=1",
      "execution_target": "browser_worker",
      "args": [
        {
          "scenario_name": "baseline",
          "fallback_customers": 500,
          "fallback_mean_interarrival_ms": 120,
          "fallback_mean_service_ms": 95,
          "replications_per_worker": 24,
          "chaos_steps": 96
        }
      ],
      "replication_factor": 4,
      "acceptance_policy": "collect_all",
      "traits": ["simulation", "stochastic"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.05"
    },
    {
      "id": "summarize-baseline",
      "depends_on": ["derive-baseline-config", "run-baseline-simulations"],
      "wasm_url": "/example-11/summarize_baseline.wasm?v=1",
      "execution_target": "server",
      "args": [
        {
          "expected_baseline_samples": 4,
          "stress_customer_bump": 90,
          "stress_interarrival_floor_ms": 28,
          "stress_service_bump_ms": 9
        }
      ],
      "replication_factor": 1,
      "traits": ["reducer", "bridge"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.00"
    },
    {
      "id": "fetch-reference-load-signal",
      "depends_on": ["summarize-baseline"],
      "wasm_url": "/example-11/fetch_reference_load_signal.wasm?v=1",
      "execution_target": "browser_worker",
      "args": [
        {
          "timeout_ms": 3000,
          "url": "https://en.wikipedia.org/w/api.php?action=query&format=json&origin=*&titles=Little%27s_law&prop=extracts&exintro=1&explaintext=1"
        }
      ],
      "replication_factor": 2,
      "acceptance_policy": "consensus",
      "traits": ["network", "deterministic"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.04"
    },
    {
      "id": "run-stress-simulations",
      "depends_on": ["summarize-baseline", "fetch-reference-load-signal"],
      "wasm_url": "/example-11/simulate_adaptive_queue.wasm?v=1",
      "execution_target": "browser_worker",
      "args": [
        {
          "scenario_name": "stress",
          "fallback_customers": 620,
          "fallback_mean_interarrival_ms": 82,
          "fallback_mean_service_ms": 108,
          "replications_per_worker": 32,
          "chaos_steps": 128
        }
      ],
      "replication_factor": 5,
      "acceptance_policy": "collect_all",
      "traits": ["simulation", "stochastic", "stress"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.06"
    },
    {
      "id": "build-final-report",
      "depends_on": [
        "fetch-queueing-metadata",
        "summarize-baseline",
        "fetch-reference-load-signal",
        "run-stress-simulations"
      ],
      "wasm_url": "/example-11/build_final_report.wasm?v=1",
      "execution_target": "server",
      "args": [
        {
          "expected_stress_samples": 5
        }
      ],
      "replication_factor": 1,
      "traits": ["report", "aggregation"],
      "result_schema": {
        "output": { "type": "object", "required": true }
      },
      "reward_usdc": "0.00"
    }
  ]
}
